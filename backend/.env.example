# MediLink API configuration. Copy to backend/.env for local development:  cp .env.example .env
# Values below match docker-compose.yml (local, non-secret defaults). Never commit a real .env.
# Production gets these from the key store / deployment environment, never from a file in git.

# --- Django ----------------------------------------------------------------------------------
# config.settings.dev | config.settings.test | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
# Set to false to ignore backend/.env entirely (CI, containers). Must be a real env var to work.
# DJANGO_READ_DOT_ENV=true
# Required in production (dev has an insecure default): 50+ random characters (python -c "import secrets; print(secrets.token_urlsafe(64))")
# DJANGO_SECRET_KEY=
# Comma-separated previous keys, for zero-downtime rotation
# DJANGO_SECRET_KEY_FALLBACKS=
# Comma-separated host names served by this API (production: api.medilink.rw)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL 17) ----------------------------------------------------------------
# Runtime role: NOSUPERUSER NOBYPASSRLS, owns no tables (row-level security applies)
DATABASE_URL=postgres://medilink_app:medilink_app_dev_only@127.0.0.1:5433/medilink
# Owner role, used only by `manage.py migrate` (and by the test runner to create test databases)
DATABASE_OWNER_URL=postgres://medilink_owner:medilink_owner_dev_only@127.0.0.1:5433/medilink
# Name of the runtime role that receives table privileges after each migrate
DATABASE_APP_ROLE=medilink_app
# Persistent connections in seconds (prod default 60)
DATABASE_CONN_MAX_AGE=0
# Statement timeout for web requests in ms (prod default 5000; 0 = off)
DATABASE_STATEMENT_TIMEOUT_MS=0
# Internal: set to "owner" by manage.py for schema commands. Leave unset.
# MEDILINK_DB_ROLE=

# --- Redis: cache, channel layer, Celery broker ----------------------------------------------
CACHE_URL=redis://127.0.0.1:6379/1
CHANNEL_LAYER_URL=redis://127.0.0.1:6379/2
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Run tasks inline instead of in a worker (dev default true; must be false in production)
CELERY_TASK_ALWAYS_EAGER=true

# --- Email -----------------------------------------------------------------------------------
# Dev: Mailpit (UI at http://localhost:8025).
# Production on Railway (decision 2026-11-19): Railway blocks outgoing SMTP below its Pro plan, so
# send through Brevo's HTTPS API (free: 300 emails a day). In Brevo: verify your address under
# Senders, domains & IPs, then create a key under SMTP & API > API keys. When BREVO_API_KEY is
# set, EMAIL_URL is not used.
#   BREVO_API_KEY=xkeysib-...
#   DEFAULT_FROM_EMAIL=MediLink Rwanda <the verified address>
# Where SMTP is allowed, Gmail with an app password still works (write @ as %40):
#   EMAIL_URL=smtp+tls://you%40gmail.com:<16-letter app password, no spaces>@smtp.gmail.com:587
# Check it with: python manage.py send_test_email you@example.com
BREVO_API_KEY=
EMAIL_URL=smtp://127.0.0.1:1025
DEFAULT_FROM_EMAIL=MediLink Rwanda <no-reply@medilink.test>

# --- Frontends (separately hosted, ADR 0006) -------------------------------------------------
# Comma-separated exact origins; no wildcards. Production: https://staff.medilink.rw,https://medilink.rw
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Defaults to CORS_ALLOWED_ORIGINS
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
# Allowed WebSocket origins; defaults to CORS_ALLOWED_ORIGINS
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Used to build links in emails (password reset)
STAFF_APP_URL=http://localhost:5173
PATIENT_APP_URL=http://localhost:5174

# --- Cookies and sessions --------------------------------------------------------------------
# Names default to __Host-ml_staff / __Host-ml_patient / __Host-ml_admin / __Host-ml_csrf in
# production and to ml_staff / ml_patient / ml_admin / ml_csrf in dev (plain http).
# STAFF_SESSION_COOKIE_NAME=
# PATIENT_SESSION_COOKIE_NAME=
# ADMIN_SESSION_COOKIE_NAME=
# CSRF_COOKIE_NAME=
# Timeouts in seconds (security 03 §5)
STAFF_SESSION_IDLE_TIMEOUT=14400
STAFF_SESSION_ABSOLUTE_TIMEOUT=43200
PATIENT_SESSION_IDLE_TIMEOUT=43200
PATIENT_SESSION_ABSOLUTE_TIMEOUT=2592000
# Patient mobile app sessions (header, PIN-locked app): idle timeout; 0 turns the app transport off
PATIENT_APP_SESSION_IDLE_TIMEOUT=2592000
# Patient sign-up email check. false = TESTING ONLY: no email is sent and new patients sign in
# straight away (also unblocks pending sign-ups). Keep true in production (security 03 §6).
PATIENT_SIGNUP_EMAIL_VERIFICATION=true
# Sign in with Google, patients only (upgrade 17). Empty = off (the button stays hidden). The Web
# client ID from Google Cloud > APIs & Services > Credentials; it is public, not a secret. The
# Android app uses the same ID (as serverClientId). Extra audiences, comma-separated, if ever needed.
GOOGLE_OAUTH_WEB_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_IDS=
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# --- Security --------------------------------------------------------------------------------
# Number of trusted reverse proxies in front of the app (X-Forwarded-For). Prod behind one proxy: 1
NUM_PROXIES=0
# Railway (docs/operations/railway.md). Railway sets RAILWAY_ENVIRONMENT_NAME itself; then its
# healthcheck host is allowed. BOOTSTRAP_DATABASE_URL (Postgres admin URL) is for the first deploy
# only: remove it once scripts/railway_bootstrap_db.py has created the roles (check medilink.W005).
# RAILWAY_ENVIRONMENT_NAME=
# BOOTSTRAP_DATABASE_URL=
# Rate limits (DRF format: N/sec|min|hour|day). IP limits are deliberately high.
THROTTLE_RATE_BURST=600/min
THROTTLE_RATE_AUTH=60/min
THROTTLE_RATE_MFA=30/min
THROTTLE_RATE_REGISTER=20/hour
THROTTLE_RATE_PASSWORD_RESET=10/hour
# Optional offline breached-password list: path to a file of SHA-1 hashes (HIBP format ok)
# PASSWORD_BREACHED_HASHES_FILE=
# Issuer shown in authenticator apps
MFA_TOTP_ISSUER=MediLink Rwanda
# Production HSTS preload (one-way commitment: enable only once the domain layout is stable)
# SECURE_HSTS_PRELOAD=false
# Development only (requires DEBUG): staff log in without the authenticator step, for local testing.
# Refused outside DEBUG (medilink.E003) and by `check --deploy` (medilink.E004). Never set in staging or production.
# DEV_SKIP_STAFF_MFA=false

# --- Tools -----------------------------------------------------------------------------------
# Django admin (OTP-protected, platform admins only). Dev default on, prod default off.
ADMIN_ENABLED=true
ADMIN_URL=ops-admin/
# OpenAPI schema at /api/v1/schema/ (+ Swagger UI in dev). Prod default off.
SCHEMA_ENABLED=true

# --- Logging ---------------------------------------------------------------------------------
LOG_LEVEL=INFO
# json | text (dev default text)
LOG_FORMAT=text

# --- TOTP secret encryption (issue #12) -----------------------------------------------------
# Required in production (development derives a key from DJANGO_SECRET_KEY): "1:<base64url 32 bytes>,2:…"
# Rotate: add a key, set the active id, run `manage.py rotate_mfa_secrets`, then drop the old key.
# MFA_SECRET_KEYS=
# MFA_SECRET_ACTIVE_KEY_ID=

# --- Audit anchor ----------------------------------------------------------------------------
# Daily export of the audit hash-chain head (security 05 §6): log (default) | email | file
# AUDIT_ANCHOR_SINK=log
# AUDIT_ANCHOR_EMAIL=security-officer@example.rw
# AUDIT_ANCHOR_FILE=/mnt/worm/medilink-audit-anchors.jsonl

# ---- Sprint settings: each sprint documents its variables ONLY between its markers ----
# [S1]
# Upload pipeline (contract §2.4). Deployments: UPLOADS_SCANNER=clamd and UPLOADS_STORAGE=s3
# (`check --deploy` refuses the fake scanner and local storage).
UPLOADS_SCANNER=fake
UPLOADS_STORAGE=local
UPLOADS_LOCAL_ROOT=./var/uploads
UPLOADS_MAX_BYTES=10485760
UPLOADS_LINK_TTL_SECONDS=300
UPLOADS_DOWNLOAD_BASE_URL=http://localhost:8000/api/v1/files
# UPLOADS_S3_ENDPOINT_URL=https://s3.example.rw
# Required with UPLOADS_STORAGE=s3 (no default: where documents live is a deployment decision)
# UPLOADS_S3_REGION=
# Optional: a KMS key ID/ARN switches server-side encryption from SSE-S3 (AES256) to SSE-KMS
# UPLOADS_S3_SSE_KMS_KEY_ID=
# UPLOADS_S3_ACCESS_KEY_ID=
# UPLOADS_S3_SECRET_ACCESS_KEY=
# UPLOADS_S3_QUARANTINE_BUCKET=medilink-quarantine
# UPLOADS_S3_DOCUMENTS_BUCKET=medilink-documents
# Or UPLOADS_STORAGE=cloudinary: files as private (authenticated) raw assets, with the CLOUDINARY_*
# credentials below (or CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>).
# CLOUDINARY_URL=
# UPLOADS_CLOUDINARY_FOLDER=medilink
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# THROTTLE_RATE_UPLOAD=60/hour

# Images on Cloudinary (medilink.images): facility photos and logos, clinician and patient avatars.
# The browser uploads straight to Cloudinary with a signature from POST .../uploads/signature/.
# The secret goes here only: never in the frontend (no VITE_* variable), never committed.
# Cloud "tha9na4a" (Test environment). The secret: Cloudinary console > Settings > API Keys.
# Or set CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name> instead of the three.
# Check the setup on the server: `python manage.py cloudinary_check`.
CLOUDINARY_CLOUD_NAME=tha9na4a
CLOUDINARY_API_KEY=755469581927969
CLOUDINARY_API_SECRET=replace-me
CLOUDINARY_UPLOAD_PRESET=medilink_signed
CLOUDINARY_ROOT_FOLDER=medilink
# THROTTLE_RATE_UPLOAD_SIGNATURE=30/hour
# Super admin console (/api/v1/platform/*): allowed client networks, comma-separated CIDRs.
# Empty allows every network (`check --deploy` warns).
PLATFORM_ALLOWED_NETWORKS=
# Staff idle lock (S1-D13): lock after this many idle seconds (300-1800); the session itself
# ends after STAFF_SESSION_IDLE_TIMEOUT (default 4 h).
STAFF_SESSION_LOCK_AFTER=900
# Applicant rate limits (contract §3.7)
# THROTTLE_RATE_APPLICATION_IP=10/hour
# THROTTLE_RATE_APPLICATION_EMAIL=3/day
# THROTTLE_RATE_RESUME_IP=10/hour
# THROTTLE_RATE_RESUME_EMAIL=3/hour
# THROTTLE_RATE_UNLOCK=10/min
# [/S1]
# [S3]
# Patient identifier encryption (contract §2.4). Comma-separated "<id>:<base64url 32 bytes>".
# Generate a key: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Empty in development: keys are derived from SECRET_KEY (check patients.W001). Required in
# production (check patients.E001). The blind-index key must differ from every field key.
MEDILINK_KEYSTORE=env
# MEDILINK_KEYSTORE=transit: the key variables below hold DEKs wrapped by an OpenBao/Vault
# Transit KEK ("1:vault:v1:…"), unwrapped once per process (medilink.core.keystore_transit).
# MEDILINK_TRANSIT_ADDR=https://bao.internal:8200
# MEDILINK_TRANSIT_TOKEN=            (or MEDILINK_TRANSIT_TOKEN_FILE=/run/secrets/bao-token)
# MEDILINK_TRANSIT_MOUNT=transit
# MEDILINK_TRANSIT_KEY=medilink-field-kek
MEDILINK_FIELD_KEYS=
MEDILINK_FIELD_ACTIVE_KEY_ID=
MEDILINK_BLIND_INDEX_KEYS=
MEDILINK_BLIND_INDEX_ACTIVE_KEY_ID=
# Rate limits (defaults shown)
# THROTTLE_RATE_PATIENTS_SEARCH=60/min
# THROTTLE_RATE_PATIENTS_VERIFICATION=10/hour
# THROTTLE_RATE_PATIENTS_REVEAL=30/hour
# Guardians add dependents under this age (legal review pending)
# PATIENTS_DEPENDENT_MAX_AGE=18
# Clinical reads: a visit this recent is a care relationship; a given access reason lasts this long
# PATIENTS_CARE_RELATIONSHIP_DAYS=30
# PATIENTS_ACCESS_REASON_TTL_SECONDS=900
# [/S3]
# [S9]
# Web push (contract sprint-09 §3.2). Generate a pair with `manage.py generate_vapid_keys`;
# without keys push is disabled (warning notifications.W001) and `check --deploy` fails (E010).
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:no-reply@medilink.rw
# Push service hosts, comma-separated; `*.` allows subdomains (default shown)
# WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,*.push.apple.com,*.notify.windows.com
# WEB_PUSH_PROXY_URL=
# Patient quiet hours (Africa/Kigali), default shown
# NOTIFICATIONS_DEFAULT_QUIET_HOURS=21:00-06:00
# Allow manage.py send_test_notification outside DEBUG (staging only)
# NOTIFICATIONS_ALLOW_TEST_SEND=false
# [/S9]
# [S2]
# Staff invitations per facility (default shown)
# THROTTLE_RATE_INVITATION=30/hour
# [/S2]
# [S10]
# Support requests: creates and requester messages per account (contract sprint-10 §3.2)
# THROTTLE_RATE_SUPPORT_WRITE=20/hour
# Public Contact page messages, per IP (upgrade 11 §13)
# THROTTLE_RATE_CONTACT_IP=10/hour
# [/S10]
# [S5]
# No-show strike policy, platform-wide (analysis 05 §4); defaults shown
# NO_SHOW_STRIKE_WARNING=3
# NO_SHOW_STRIKE_LIMIT=4
# NO_SHOW_STRIKE_WINDOW_DAYS=90
# NO_SHOW_LIMIT_DAYS=30
# [/S5]

# AI symptom assistant (issue #159). Test phase only: the hosted NVIDIA API sends symptom text
# outside Rwanda. Never use it with real patients; production points NVIDIA_API_BASE at a NIM
# hosted in Rwanda. The key is server-side only.
# ASSISTANT_ENABLED=false
# NVIDIA_API_KEY=
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_DISABLE_THINKING=true
# NVIDIA_TIMEOUT_SECONDS=30
