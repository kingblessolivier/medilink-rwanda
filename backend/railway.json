{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["sh -c \"python scripts/railway_bootstrap_db.py && python manage.py migrate --noinput\""],
    "startCommand": "sh -c \"uvicorn config.asgi:application --host 0.0.0.0 --port $PORT --proxy-headers --no-server-header --workers 2\"",
    "healthcheckPath": "/api/v1/health/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
